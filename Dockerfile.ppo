FROM python:3.11-slim
WORKDIR /app
COPY requirements-ppo.txt ./requirements-ppo.txt
RUN pip install --no-cache-dir -r requirements-ppo.txt
COPY src/__init__.py ./src/__init__.py
COPY src/ppo_agent.py src/ppo_env.py src/ppo_k8s_app.py ./src/
COPY models/ppo_autoscaler.npz models/seed_history.json ./models/
ENV PYTHONUNBUFFERED=1
EXPOSE 8000 8001
CMD ["sh", "-c", "if [ \"$APP_ROLE\" = worker ]; then uvicorn src.ppo_k8s_app:app --host 0.0.0.0 --port 8001; else uvicorn src.ppo_k8s_app:app --host 0.0.0.0 --port 8000; fi"]
